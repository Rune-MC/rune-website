# Session signing secret for the JWT cookie.
# Generate one with: openssl rand -base64 32
# At least 32 characters. NEVER commit a real value. NEVER expose to the browser.
AUTH_SECRET=replace-with-32-plus-character-secret

# GitHub OAuth — create an OAuth App at https://github.com/settings/developers
# Authorization callback URL must be: <origin>/api/auth/github/callback
# Dev: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# MongoDB — Atlas or self-hosted
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/rune?retryWrites=true&w=majority
# Local: mongodb://localhost:27017/rune
MONGODB_URI=mongodb://localhost:27017/rune

# Optional: GitHub repo URL (used by the marketing footer + /install manual link).
# NEXT_PUBLIC_REPO_URL=https://github.com/your-org/rune

# Cloudflare R2 — content-addressed blob storage (Phase 3, publish API)
# Create an R2 bucket + API token at https://dash.cloudflare.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=rune-blobs
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Optional: public base URL for the R2 bucket. When set, blob + manifest
# redirects go straight to the CDN-fronted public URL instead of a
# presigned URL. Use the bucket's pub-<id>.r2.dev URL or a custom domain.
# R2_PUBLIC_BASE_URL=https://pub-<id>.r2.dev

# Auto-injected by Vercel in production; the marketing footer renders the
# last-commit hash. Override locally if you want a real hash in dev.
# NEXT_PUBLIC_COMMIT_SHA=
